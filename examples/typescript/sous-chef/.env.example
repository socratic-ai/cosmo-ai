# Copy to .env (gitignored — never commit real keys):
#   cp .env.example .env
#
# A Cosmo workspace API key with the `realtime:use` scope, from
# Developer platform → API keys in the Cosmo web app. Local dev only —
# see the README for how a deployed build keeps its key server-side.
VITE_COSMO_API_KEY=

# Which Cosmo backend to connect to.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# Which realtime provider runs the cook: openai (default) or gemini. The agent
# is identical either way. GPT Realtime needs the OpenAI provider enabled on
# the workspace — see the README.
# VITE_REALTIME_PROVIDER=gemini

# NOTE: VITE_* variables are inlined into the built bundle by Vite. They're
# fine for local dev, but don't run `npm run build` with a real key in here
# and then serve dist/ — you'd be publishing the key. Anything you deploy
# should mint short-lived end-user tokens instead; see the token-server
# example.
