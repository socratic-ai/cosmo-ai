# Copy to .env (gitignored — never commit real keys):
#   cp .env.example .env
#
# Optional: the app also lets you paste a key into the form at runtime.
# Setting it here just saves retyping on every run.

# A Cosmo workspace API key with the `realtime:use` scope, from
# Developer platform → API keys in the Cosmo web app.
VITE_COSMO_API_KEY=

# Which Cosmo backend to connect to.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# NOTE: VITE_* variables are inlined into the built bundle by Vite. They're
# fine for local dev, but don't run `npm run build` with a real key in here
# and then serve dist/ — you'd be publishing the key. Use `npm run
# pages:build` (blanks it) for anything that leaves your machine.
