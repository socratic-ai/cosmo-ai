{
  "name": "cosmo-docs-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "preview": "vite preview",
    "pages:build": "VITE_COSMO_API_KEY= vite build && node scripts/assert-no-credential.js",
    "pages:dev": "npm run pages:build && wrangler pages dev",
    "pages:deploy": "npm run pages:build && wrangler pages deploy"
  },
  "dependencies": {
    "cosmo-ai": "^0.3.0",
    "dotenv": "^17",
    "express": "^5",
    "livekit-client": "^2",
    "pdfjs-dist": "^4.8.69",
    "react": "^19",
    "react-dom": "^19",
    "sanitize-html": "^2.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^5",
    "wrangler": "^4"
  }
}
