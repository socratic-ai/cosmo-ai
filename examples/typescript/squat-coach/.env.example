# Copy to .env (gitignored — never commit real keys):
#   cp .env.example .env
#
# Nothing here blocks the app from starting, but read the notes on each.


# --- Gemini (optional, but it's most of the point) -------------------------
# Enables the visual-analysis passes: spine rounding, butt wink, and catching
# "reps" that weren't really reps. Without it the demo still runs and you can
# still talk to the coach, but only about what joint angles can measure.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --- Cosmo realtime (needed to start a voice session) ----------------------
# Optional here only because the app also lets you paste these into the form
# at runtime. Setting them saves retyping on every run.
#
# From your Cosmo workspace (Developer platform → API keys); needs the
# realtime:use scope.
VITE_COSMO_API_KEY=

# Which Cosmo backend to connect to. Leave as-is unless you've been given a
# non-production backend to test against.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai


# --- Local overrides (rarely needed) ---------------------------------------
# Python interpreter for the pipeline. Defaults to pipeline/venv/bin/python,
# which is what the README's setup steps create.
# SQUAT_COACH_PYTHON=

# Port for the pipeline backend. The Vite dev server proxies to 7861.
# SQUAT_COACH_PORT=7861

# NOTE: VITE_* variables are inlined into the built bundle by Vite. They're
# fine for local dev, but don't run `npm run build` with a real key in here
# and then serve dist/ — you'd be publishing the key.
