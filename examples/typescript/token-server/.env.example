# Required: a workspace API key. Best practice: create a key with ONLY the
# user_tokens:mint scope (a provisioning key) so this server can mint but
# never open sessions or dial.
COSMO_API_KEY=cosmo_...

# Optional: shared secret for the out-of-the-box auth mode. Callers send
# Authorization: Bearer <MINT_SECRET> + X-External-User-Id. Replace with
# real auth (identifyUser in handler.js) before distributing to strangers.
# MINT_SECRET=change-me

# Optional: lock CORS to your app's origin (default: *).
# ALLOWED_ORIGIN=https://app.example.com

# Optional: point at a non-production Cosmo backend.
# COSMO_BASE_URL=https://platform.askcosmo.ai

# Optional: port for `node server.js` (default 8787).
# PORT=8787
